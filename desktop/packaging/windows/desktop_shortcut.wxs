<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <StandardDirectory Id="DesktopFolder">
            <Component Id="DesktopShortcutComponent" Guid="*">
                <Shortcut
                    Id="DesktopShortcut"
                    Name="Tremotesf"
                    Description="Tremotesf torrent client"
                    Target="[#CM_FP_tremotesf.exe]"
                    WorkingDirectory="INSTALL_ROOT"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Tremotesf\Tremotesf"
                    Name="desktopShortcut"
                    Type="integer"
                    Value="1"
                    KeyPath="yes"
                />
            </Component>
        </StandardDirectory>

        <Feature
            Id="DesktopShortcutFeature"
            Title="Desktop shortcut"
            Description="Create a Tremotesf shortcut on the Desktop"
            Level="1"
            AllowAbsent="yes"
        >
            <ComponentRef Id="DesktopShortcutComponent" />
        </Feature>
    </Fragment>
</Wix>
