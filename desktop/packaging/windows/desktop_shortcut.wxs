<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <StandardDirectory Id="DesktopFolder">
            <Component Id="DesktopShortcutComponent" Guid="*" Condition="DESKTOPSHORTCUT">
                <Shortcut
                    Id="DesktopShortcut"
                    Name="Tremotesf"
                    Description="Tremotesf torrent client"
                    Target="[#CM_FP_tremotesf.exe]"
                    WorkingDirectory="INSTALL_ROOT"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Tremotesf\Tremotesf"
                    Name="desktopShortcut"
                    Type="integer"
                    Value="1"
                    KeyPath="yes"
                />
            </Component>
        </StandardDirectory>
    </Fragment>
</Wix>
